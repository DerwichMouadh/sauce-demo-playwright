{
  "compilerOptions": {
    "target": "ESNext", // Specify ECMAScript target version (Use modern JavaScript features)
    "module": "commonjs", // Specify module code generation (CommonJS for Node.js)
    "strict": true, // Enable all strict type-checking options
    "esModuleInterop": true, // Enable interoperability between CommonJS and ES Modules
    "types": ["node"] // It gives TypeScript knowledge about Node.js APIs
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts",
    "actions/**/*.ts",
    "fixtures/**/*.ts",
    "data/**/*.ts"
  ]
}